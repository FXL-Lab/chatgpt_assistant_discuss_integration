<?xml version="1.0"?>
<odoo>
    <record id="is_chatgpt_res_config_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.chatgpt.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="chatgpt_settings" string="ChatGPT Integration" data-string="ChatGPT Integration" logo="/chatgpt_assistant_discuss_integration/static/description/icon.png">
                    <block title="ChatGPT Configuration" name="chatgpt_block">

                        <setting id="chatgpt_api_key_setting">
                            <field name="chatgpt_api_key"/>
                        </setting>

                        <setting id="chatgpt_default_model_setting">
                            <field name="chatgpt_default_model"/>
                        </setting>

                        <setting id="chatgpt_models_refresh_setting" string="Available OpenAI Models">
                            <button name="action_refresh_openai_models" type="object" string="Refresh Models" class="btn btn-secondary"/>
                            <div class="text-muted mt-2" invisible="not chatgpt_models_last_updated">
                                Last refreshed: <field name="chatgpt_models_last_updated" readonly="1" class="oe_inline"/>
                            </div>
                        </setting>

                        <setting id="chatgpt_default_instructions_setting">
                            <field name="chatgpt_default_instructions" widget="text" rows="16" class="chatgpt-instructions w-100"/>
                        </setting>

                        <setting id="enable_chatgpt_assistant_setting">
                            <field name="enable_chatgpt_assistant_response"/>
                        </setting>

                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
