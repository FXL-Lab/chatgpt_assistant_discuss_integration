<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_chatgpt_inactivity_followup" model="ir.cron">
        <field name="name">Livechat: Send ChatGPT inactivity follow-ups</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="code">model._cron_send_inactivity_followups()</field>
        <field name="state">code</field>
    </record>
</odoo>
