<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Composer.attachFiles" t-inherit-mode="extension">
        <xpath expr="//FileUploader" position="attributes">
            <attribute name="acceptedFileExtensions">thread?.channel_type === 'livechat' ? '.pdf,.jpg,.jpeg,.png,.webp' : '*'</attribute>
        </xpath>
    </t>
</templates>
